<html>
  <head>
    <title>Login</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <form method="POST" action="register" class="login">
      <h1>FileUpload</h1>
      <input required type="text" name="username" placeholder="Enter your username"/>
      <input required type="password" name="password" placeholder="Enter your password"/>
      <input required type="password" name="password_repeat" placeholder="Repeat your password"/>
      <button type="submit">Register</button>
      <br>
      <br>
      <a href="/auth/login">Login to an existing account</a>
    </form>
  </body>
</html>
